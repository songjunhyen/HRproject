<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.songjunhyen.hrms.dao.DepartmentDao">

    <!-- 컬럼 ↔ 필드 매핑 -->
    <resultMap id="DeptMap" type="com.songjunhyen.hrms.domain.Department">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 공통 컬럼 -->
    <sql id="BaseColumns">
        id, name, parent_id, created_at, updated_at
    </sql>

    <!-- 전체 목록 조회 -->
    <select id="findAll" resultMap="DeptMap">
        SELECT <include refid="BaseColumns"/>
        FROM departments
        ORDER BY id
    </select>

    <!-- 단건 조회 (Controller나 테스트용으로 유용) -->
    <select id="findById" parameterType="int" resultMap="DeptMap">
        SELECT <include refid="BaseColumns"/>
        FROM departments
        WHERE id = #{value}
    </select>

    <!-- 부서 추가 -->
    <insert id="insert" parameterType="com.songjunhyen.hrms.domain.Department" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO departments (name, parent_id)
        VALUES (#{name}, #{parentId})
    </insert>

    <!-- 부서 수정 -->
    <update id="update" parameterType="com.songjunhyen.hrms.domain.Department">
        UPDATE departments
        SET name = #{name},
        parent_id = #{parentId},
        updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 부서 삭제 -->
    <delete id="delete" parameterType="int">
        DELETE FROM departments WHERE id = #{value}
    </delete>

    <select id="findNameById" parameterType="int" resultType="string">
        SELECT name FROM departments WHERE id = #{value} LIMIT 1
    </select>
</mapper>
